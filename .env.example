WEATHER_AGENT_TELEGRAM__BOT_TOKEN=<telegram-bot-token>
WEATHER_AGENT_TELEGRAM__ALLOWED_USER_IDS=123456789,987654321

WEATHER_AGENT_DATABASE_URL=postgresql+psycopg://weather_agent:weather_agent@localhost:5432/weather_agent

WEATHER_AGENT_MODEL__PROVIDER=openai
WEATHER_AGENT_MODEL__MODEL_NAME=gpt-5-mini
WEATHER_AGENT_MODEL__TEMPERATURE=0.2
WEATHER_AGENT_MODEL__API_KEY=<openai-api-key>
WEATHER_AGENT_MODEL__BASE_URL=

WEATHER_AGENT_LANGSMITH__ENABLED=false
WEATHER_AGENT_LANGSMITH__API_KEY=
WEATHER_AGENT_LANGSMITH__PROJECT=weather-agent-dev
WEATHER_AGENT_LANGSMITH__ENDPOINT=https://api.smith.langchain.com

WEATHER_AGENT_OPEN_METEO__BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_AGENT_OPEN_METEO__MODEL=dwd-icon
WEATHER_AGENT_OPEN_METEO__TIMEOUT_SECONDS=15

WEATHER_AGENT_IMGW__SYNOP_BASE_URL=https://danepubliczne.imgw.pl/api/data/synop
WEATHER_AGENT_IMGW__WARNINGS_BASE_URL=https://danepubliczne.imgw.pl/api/data/warningsmeteo
WEATHER_AGENT_IMGW__TIMEOUT_SECONDS=15

WEATHER_AGENT_NAGER_DATE__BASE_URL=https://date.nager.at/api/v3
WEATHER_AGENT_NAGER_DATE__COUNTRY_CODE=PL
WEATHER_AGENT_NAGER_DATE__TIMEOUT_SECONDS=10

WEATHER_AGENT_UNITS__TEMPERATURE=celsius
WEATHER_AGENT_UNITS__WIND_SPEED=ms
WEATHER_AGENT_UNITS__PRECIPITATION=mm
WEATHER_AGENT_UNITS__PRESSURE=hpa

WEATHER_AGENT_SCHEDULER__FORECAST_REFRESH_MINUTES=30
WEATHER_AGENT_SCHEDULER__RULE_EVALUATION_MINUTES=15
WEATHER_AGENT_SCHEDULER__WARNING_POLL_MINUTES=15

WEATHER_AGENT_RETENTION__THREAD_MEMORY_DAYS=14
WEATHER_AGENT_RETENTION__RAW_FORECAST_DAYS=60
WEATHER_AGENT_RETENTION__AGGREGATED_WEATHER_DAYS=90
WEATHER_AGENT_RETENTION__NOTIFICATION_LOG_DAYS=365
WEATHER_AGENT_RETENTION__AUDIT_LOG_DAYS=365
WEATHER_AGENT_RETENTION__TRACE_DAYS=14

WEATHER_AGENT_DEFAULT_TIMEZONE=Europe/Warsaw
WEATHER_AGENT_DEFAULT_LANGUAGE=pl-PL
